load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")
load("//mutants:cargo_mutants_test.bzl", "cargo_mutants_test")

package(default_visibility = ["//visibility:public"])

exports_files(["mutants_config.toml"])

NOT_WINDOWS = select({
    "@platforms//os:windows": ["@platforms//:incompatible"],
    "//conditions:default": [],
})

genrule(
    name = "compile_data",
    outs = ["compile_data.bin"],
    cmd = "printf '\\377' > $@",
    cmd_bat = "powershell -NoProfile -NonInteractive -Command \"[IO.File]::WriteAllBytes('$@', [byte[]](255))\"",
)

rust_library(
    name = "well_tested",
    srcs = ["well_tested.rs"],
    compile_data = [":compile_data"],
    crate_name = "well_tested",
    edition = "2024",
)

rust_test(
    name = "well_tested_test",
    args = ["--nocapture"],
    crate = ":well_tested",
    data = ["runtime_data.txt"],
    env = {"MUTANTS_TEST_ENV": "present"},
)

# Sharded and parallel, so `bazel test //example/...` covers both fan-out paths.
cargo_mutants_test(
    name = "well_tested_mutants",
    timeout = "long",
    jobs = 2,
    shard_count = 2,
    target_compatible_with = NOT_WINDOWS,
    test = ":well_tested_test",
)

rust_library(
    name = "under_tested",
    srcs = ["under_tested.rs"],
    crate_name = "under_tested",
    edition = "2024",
)

rust_test(
    name = "under_tested_test",
    crate = ":under_tested",
)

# Expected to fail: `triple` has no test covering it.
cargo_mutants_test(
    name = "under_tested_mutants",
    timeout = "long",
    jobs = 2,
    tags = ["manual"],
    target_compatible_with = NOT_WINDOWS,
    test = ":under_tested_test",
)

rust_test(
    name = "under_tested_mutants_failure_test",
    timeout = "long",
    srcs = ["expect_missed_mutants.rs"],
    args = [
        "$(rootpath :under_tested_mutants)",
        "MISSED under_tested.rs",
    ],
    data = [":under_tested_mutants"],
    edition = "2024",
    target_compatible_with = NOT_WINDOWS,
    use_libtest_harness = False,
)

# `scale` is covered only from an integration crate, so the sweep sees nothing
# without `integration_tests` and everything with it. Both directions are
# asserted below, which is what keeps the `--extern` rewrite honest: point it at
# the unmutated rlib and `covered` would pass while `uncovered` also passed.
rust_library(
    name = "integration_covered",
    srcs = ["integration_covered.rs"],
    crate_name = "integration_covered",
    edition = "2024",
)

rust_test(
    name = "integration_covered_unit_test",
    crate = ":integration_covered",
)

rust_test(
    name = "integration_covered_suite",
    srcs = ["integration_covered_test.rs"],
    edition = "2024",
    deps = [":integration_covered"],
)

rust_test(
    name = "integration_covered_second_suite",
    srcs = ["integration_covered_second_test.rs"],
    edition = "2024",
    deps = [":integration_covered"],
)

cargo_mutants_test(
    name = "integration_covered_mutants",
    timeout = "long",
    # Two suites, not one: a flag pair per suite overflowed the launcher stub's
    # ten-argument limit at exactly two, so one suite would not catch it.
    integration_tests = [
        ":integration_covered_second_suite",
        ":integration_covered_suite",
    ],
    library = ":integration_covered",
    target_compatible_with = NOT_WINDOWS,
    test = ":integration_covered_unit_test",
)

# The same library without the integration suite: every mutant of `scale`
# survives, which is the behaviour before this feature existed.
cargo_mutants_test(
    name = "integration_covered_unit_only_mutants",
    timeout = "long",
    tags = ["manual"],
    target_compatible_with = NOT_WINDOWS,
    test = ":integration_covered_unit_test",
)

# A mutant caught by unit tests must never reach the integration relink. The
# suite deliberately stops compiling when `guarded` is mutated, so an eager
# relink reports the mutant as unviable instead of caught.
rust_library(
    name = "unit_first",
    srcs = ["unit_first.rs"],
    crate_name = "unit_first",
    edition = "2024",
)

rust_test(
    name = "unit_first_test",
    crate = ":unit_first",
)

rust_test(
    name = "unit_first_suite",
    srcs = ["unit_first_test.rs"],
    edition = "2024",
    deps = [":unit_first"],
)

cargo_mutants_test(
    name = "unit_first_mutants",
    integration_tests = [":unit_first_suite"],
    library = ":unit_first",
    tags = ["manual"],
    target_compatible_with = NOT_WINDOWS,
    test = ":unit_first_test",
)

rust_test(
    name = "unit_first_mutants_output_test",
    srcs = ["expect_mutants_output.rs"],
    args = [
        "$(rootpath :unit_first_mutants)",
        "caught, 0 missed, 0 unviable",
    ],
    data = [":unit_first_mutants"],
    edition = "2024",
    target_compatible_with = NOT_WINDOWS,
    use_libtest_harness = False,
)

rust_test(
    name = "integration_uncovered_failure_test",
    timeout = "long",
    srcs = ["expect_missed_mutants.rs"],
    args = [
        "$(rootpath :integration_covered_unit_only_mutants)",
        "MISSED integration_covered.rs",
    ],
    data = [":integration_covered_unit_only_mutants"],
    edition = "2024",
    target_compatible_with = NOT_WINDOWS,
    use_libtest_harness = False,
)
