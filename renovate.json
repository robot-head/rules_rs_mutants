{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    ":dependencyDashboard",
    ":semanticPrefixFixDepsChoreOthers",
    "group:monorepos",
    "group:recommended",
    "replacements:all",
    "workarounds:all"
  ],
  "packageRules": [
    {
      "description": "cargo-mutants' --list --json output is the integration contract; bumps need the example rerun by hand.",
      "matchFileNames": ["example/Cargo.toml", "example/Cargo.lock"],
      "dependencyDashboardApproval": true,
      "automerge": true
    }
  ]
}
